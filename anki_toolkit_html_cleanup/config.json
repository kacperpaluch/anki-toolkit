{
  "show_tooltip": true,
  "auto_run_startup": false,
  "rules": [
    {
      "on": true,
      "name": "&nbsp; → spacja",
      "find": "&nbsp;",
      "to": " ",
      "regex": false,
      "fields": "",
      "repeat": false
    },
    {
      "on": true,
      "name": "Bloki <div> → <br>",
      "find": "</?div\\b[^>]*>",
      "to": "<br>",
      "regex": true,
      "fields": "!ang",
      "repeat": false
    },
    {
      "on": true,
      "name": "Usuń tagi <div>",
      "find": "</?div[^>]*>",
      "to": "",
      "regex": true,
      "fields": "ang",
      "repeat": false
    },
    {
      "on": true,
      "name": "Scal sąsiadujące <br>",
      "find": "(?:<br>\\s*){2,}",
      "to": "<br>",
      "regex": true,
      "fields": "!ang",
      "repeat": false
    },
    {
      "on": true,
      "name": "Obetnij brzegowe <br>",
      "find": "^(?:<br>\\s*)+|(?:<br>\\s*)+$",
      "to": "",
      "regex": true,
      "fields": "!ang",
      "repeat": false
    }
  ]
}
